rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & Role Checking
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        ? getUserData().role
        : '';
    }

    function isFounder() {
      return isAuthenticated() && (getUserRole() == 'Founder' || getUserRole() == 'FOUNDER');
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'Admin' || getUserRole() == 'ADMIN' || isFounder());
    }

    function isSalesManager() {
      return isAuthenticated() && (getUserRole() == 'Sales Manager' || getUserRole() == 'SALES_MANAGER' || isAdmin());
    }

    function isSalesExecutive() {
      return isAuthenticated() && (getUserRole() == 'Sales Executive' || getUserRole() == 'SALES_EXECUTIVE' || isSalesManager());
    }

    function isOperations() {
      return isAuthenticated() && (getUserRole() == 'Operations' || getUserRole() == 'OPERATIONS' || isAdmin());
    }

    function isMarketing() {
      return isAuthenticated() && (getUserRole() == 'Marketing' || getUserRole() == 'MARKETING' || isAdmin());
    }

    function isAccounts() {
      return isAuthenticated() && (getUserRole() == 'Accounts' || getUserRole() == 'ACCOUNTS' || isAdmin());
    }

    // 1. Employees Collection
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isFounder();
    }

    // 2. Customers Collection
    match /customers/{customerId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create, update: if isSalesExecutive();
      allow delete: if isAdmin();
    }

    // 3. Leads Collection (Scoped access)
    match /leads/{leadId} {
      allow read: if isSalesManager() || isAccounts() || 
                  (isSalesExecutive() && (resource.data.assignedEmployeeId == request.auth.uid || resource.data.assignedEmployeeId == ''));
      allow create, update: if isSalesExecutive();
      allow delete: if isAdmin();
    }

    // 4. Companies Collection
    match /companies/{companyId} {
      allow read: if isSalesExecutive() || isAccounts() || isAdmin();
      allow create, update: if isSalesExecutive();
      allow delete: if isAdmin();
    }

    // 5. Conversations Collection
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 6. Messages Collection (Append-only)
    match /messages/{messageId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 7. Tasks Collection
    match /tasks/{taskId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 8. Quotes Collection
    match /quotes/{quoteId} {
      allow read: if isSalesExecutive() || isAccounts();
      allow create, update: if isSalesExecutive();
      allow delete: if isAdmin();
    }

    // 9. Quote Conversions Collection (Immutable Server-Authoritative Conversion Markers)
    match /quote_conversions/{conversionId} {
      // Read restricted to Founder, Admin, Accounts for audit tracing
      allow read: if isFounder() || isAdmin() || isAccounts();
      // DIRECT CLIENT MUTATION PROHIBITED FOR ALL ROLES (Server Admin SDK Only)
      allow create, update, delete: if false;
    }

    // 10. Bookings Collection (Commercial Root)
    match /bookings/{bookingId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      // Direct client creation restricted to Admin (created via Server Conversion Engine)
      allow create: if isAdmin();
      // Top-level bookings must NOT permit clients to directly modify:
      // totalSellingPrice, amountReceived, amountPending, paymentStatus, confirmationProgress, schemaVersion
      allow update: if (isSalesExecutive() || isOperations() || isAccounts()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'totalSellingPrice',
          'amountReceived',
          'amountPending',
          'paymentStatus',
          'isOverpaid',
          'overpaidAmount',
          'confirmationProgress',
          'schemaVersion'
        ]);
      allow delete: if isAdmin();

      // RESTRICTED FINANCIAL SNAPSHOT (SUBCOLLECTION)
      match /financial_snapshot/{snapshotId} {
        // Read strictly restricted to Founder, Admin, Accounts
        allow read: if isFounder() || isAdmin() || isAccounts();
        // DIRECT CLIENT MUTATION PROHIBITED FOR ALL ROLES (Server Admin SDK Only)
        allow create, update, delete: if false;
      }
    }

    // 10. Trips & Itinerary Collections
    match /trips/{tripId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create: if isAdmin() || isAccounts() || (isSalesExecutive() && !request.resource.data.keys().hasAny(['totalCost', 'grossProfit', 'grossMargin']));
      allow update: if isAdmin() || isAccounts() || ((isSalesExecutive() || isOperations()) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalCost', 'grossProfit', 'grossMargin']));
      allow delete: if isAdmin();
    }

    match /itinerary_days/{dayId} {
      allow read: if isSalesExecutive() || isOperations();
      allow create, update: if isSalesExecutive() || isOperations();
      allow delete: if isAdmin();
    }

    // 11. Accommodation Inventory & Rate Management
    match /accommodation_properties/{propertyId} {
      allow read: if isAuthenticated();
      // Only Admin and Operations can manage base accommodation details
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /room_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /property_photos/{photoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isOperations();
    }

    // Rate Management — STRICLTY GATED
    match /rate_periods/{rateId} {
      // Readable by Operations, Accounts, and Leadership
      allow read: if isOperations() || isAccounts() || isAdmin();
      // Manageable by Operations and Leadership
      allow create, update: if isOperations() || isAdmin();
      allow delete: if isAdmin();
    }

    match /rate_supplements/{supplementId} {
      allow read: if isOperations() || isAccounts() || isAdmin();
      allow create, update: if isOperations() || isAdmin();
      allow delete: if isAdmin();
    }

    match /negotiated_rates/{rateId} {
      // Readable by Accounts and Leadership
      allow read: if isAccounts() || isAdmin();
      // Manageable by Accounts and Leadership
      allow create, update: if isAccounts() || isAdmin();
      allow delete: if isAdmin();
    }

    match /rate_history/{historyId} {
      allow read: if isAccounts() || isAdmin();
      allow create: if isAccounts() || isOperations() || isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // =========================================================================
    // PHASE 2B-4: TRANSPORT & ACTIVITY INVENTORY
    // =========================================================================

    match /vehicle_categories/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /destinations/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /transport_routes/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /transport_rate_periods/{docId} {
      allow read: if isOperations() || isAccounts() || isAdmin();
      allow create, update: if isOperations() || isAdmin();
      allow delete: if isAdmin();
    }

    match /transport_supplements/{docId} {
      allow read: if isOperations() || isAccounts() || isAdmin();
      allow create, update: if isOperations() || isAdmin();
      allow delete: if isAdmin();
    }

    match /negotiated_transport_rates/{docId} {
      allow read: if isAccounts() || isAdmin();
      allow create, update: if isAccounts() || isAdmin();
      allow delete: if isAdmin();
    }

    match /activity_masters/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /activity_rate_periods/{docId} {
      allow read: if isOperations() || isAccounts() || isAdmin();
      allow create, update: if isOperations() || isAdmin();
      allow delete: if isAdmin();
    }

    match /negotiated_activity_rates/{docId} {
      allow read: if isAccounts() || isAdmin();
      allow create, update: if isAccounts() || isAdmin();
      allow delete: if isAdmin();
    }

    match /transport_rate_history/{docId} {
      allow read: if isAccounts() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /activity_rate_history/{docId} {
      allow read: if isAccounts() || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // PHASE 2B-5: MODERN SERVICE COLLECTIONS
    // =========================================================================

    match /booking_accommodations/{docId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create: if isAdmin(); // Created via Server Conversion Engine
      
      // Sales may modify ONLY guestNames, specialRequests
      // Operations may modify ONLY operational fields (cannot touch commercial/itinerary fields)
      allow update: if isAdmin() ||
        (isOperations() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'bookingId', 'tripId', 'customerId', 'propertyId', 'propertyName', 'roomCategoryId',
          'roomCategoryName', 'mealPlan', 'checkInDate', 'checkOutDate', 'nightsCount',
          'roomsCount', 'adultsCount', 'childrenCount', 'schemaVersion'
        ])) ||
        (isSalesExecutive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'guestNames', 'specialRequests'
        ]));
      allow delete: if isAdmin();
    }

    match /booking_transports/{docId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create: if isAdmin(); // Created via Server Conversion Engine
      
      // Sales may modify ONLY passengerCount, specialRequests
      // Operations may modify ONLY operational fields (cannot touch commercial/route fields)
      allow update: if isAdmin() ||
        (isOperations() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'bookingId', 'tripId', 'customerId', 'vehicleCategoryId', 'vehicleCategoryName',
          'routeId', 'routeName', 'serviceDate', 'endDate', 'daysCount', 'pickupLocation',
          'dropoffLocation', 'pickupTime', 'schemaVersion'
        ])) ||
        (isSalesExecutive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'passengerCount', 'specialRequests'
        ]));
      allow delete: if isAdmin();
    }

    match /booking_activities/{docId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create: if isAdmin(); // Created via Server Conversion Engine
      
      // Sales may modify ONLY participantCount, leadGuestName, specialRequests
      // Operations may modify ONLY operational fields (cannot touch commercial/master fields)
      allow update: if isAdmin() ||
        (isOperations() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'bookingId', 'tripId', 'customerId', 'activityMasterId', 'activityName',
          'destinationId', 'destinationName', 'serviceDate', 'sessionTime', 'schemaVersion'
        ])) ||
        (isSalesExecutive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantCount', 'leadGuestName', 'specialRequests'
        ]));
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PHASE 2B-5: PAYMENTS COLLECTION
    // =========================================================================

    match /payments/{paymentId} {
      // Scoped read: Founder, Admin, Accounts have enterprise access; Sales/Ops checked against booking
      allow read: if isFounder() || isAdmin() || isAccounts() || (
        isAuthenticated() && (
          (isSalesExecutive() && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.assignedSalesEmployeeId == request.auth.uid) ||
          (isSalesManager() && (
            get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.assignedSalesManagerId == request.auth.uid ||
            get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.assignedSalesEmployeeId == request.auth.uid
          )) ||
          (isOperations() && (
            get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.assignedOperationsEmployeeId == request.auth.uid
          ))
        )
      );
      
      // Sales and Accounts can record payments with status 'RECORDED' only
      // verifiedBy, verifiedByName, verifiedAt, voidedBy, voidedAt CANNOT be set during recording
      allow create: if (isSalesExecutive() || isSalesManager() || isAccounts() || isAdmin()) &&
        request.resource.data.status == 'RECORDED' &&
        request.resource.data.amount > 0 &&
        (!('verifiedBy' in request.resource.data) || request.resource.data.verifiedBy == null) &&
        (!('verifiedByName' in request.resource.data) || request.resource.data.verifiedByName == null) &&
        (!('verifiedAt' in request.resource.data) || request.resource.data.verifiedAt == null) &&
        (!('voidedBy' in request.resource.data) || request.resource.data.voidedBy == null) &&
        (!('voidedByName' in request.resource.data) || request.resource.data.voidedByName == null) &&
        (!('voidedAt' in request.resource.data) || request.resource.data.voidedAt == null) &&
        (!('voidReason' in request.resource.data) || request.resource.data.voidReason == null) &&
        (!('rejectionReason' in request.resource.data) || request.resource.data.rejectionReason == null);
        
      // Verification restricted strictly to Accounts & Admin (Sales CANNOT verify payments)
      // Server-side backend verification is authoritative and updates booking aggregates atomically
      allow update: if (isAccounts() || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bookingId', 'amount', 'currency']);
        
      allow delete: if false; // Permanent audit records; client deletes strictly denied
    }

    // =========================================================================
    // 12. LEGACY COLLECTIONS (STRICT READ-ONLY HISTORICAL FREEZE)
    // =========================================================================
    match /hotels/{hotelId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /hotel_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /hotel_bookings/{bookingId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create, update, delete: if false; // Frozen: Read-only historical collection
    }

    match /transports/{transportId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create, update, delete: if false; // Frozen: Read-only historical collection
    }

    match /drivers/{driverId} {
      allow read: if isSalesExecutive() || isOperations();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /activity_bookings/{bookingId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create, update, delete: if false; // Frozen: Read-only historical collection
    }

    // 12. Suppliers & Vouchers
    match /suppliers/{supplierId} {
      allow read: if isOperations() || isAccounts();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /vouchers/{voucherId} {
      allow read: if isSalesExecutive() || isOperations();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    // 13. Packages
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 14. Audit Logs (Append-only, strictly immutable)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isAccounts();
      allow create: if isAuthenticated() && request.resource.data.actorId != null;
      allow update, delete: if false;
    }

    // 15. AI Recommendations, Actions, and Approvals
    match /ai_recommendations/{recId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    match /ai_actions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isSalesManager() || isAccounts();
      allow delete: if false;
    }

    match /approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSalesManager() || isAccounts();
      allow delete: if false;
    }

    // Default: Deny all unauthenticated or unlisted collection access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
