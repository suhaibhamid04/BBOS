rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & Role Checking
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        ? getUserData().role
        : '';
    }

    function isFounder() {
      return isAuthenticated() && (getUserRole() == 'Founder' || getUserRole() == 'FOUNDER');
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'Admin' || getUserRole() == 'ADMIN' || isFounder());
    }

    function isSalesManager() {
      return isAuthenticated() && (getUserRole() == 'Sales Manager' || getUserRole() == 'SALES_MANAGER' || isAdmin());
    }

    function isSalesExecutive() {
      return isAuthenticated() && (getUserRole() == 'Sales Executive' || getUserRole() == 'SALES_EXECUTIVE' || isSalesManager());
    }

    function isReservations() {
      return isAuthenticated() && (getUserRole() == 'Reservations' || getUserRole() == 'RESERVATIONS' || isAdmin());
    }

    function isOperations() {
      return isAuthenticated() && (getUserRole() == 'Operations' || getUserRole() == 'OPERATIONS' || isAdmin());
    }

    function isMarketing() {
      return isAuthenticated() && (getUserRole() == 'Marketing' || getUserRole() == 'MARKETING' || isAdmin());
    }

    function isAccounts() {
      return isAuthenticated() && (getUserRole() == 'Accounts' || getUserRole() == 'ACCOUNTS' || isAdmin());
    }

    // 1. Employees Collection
    match /employees/{employeeId} {
      // Employee identity, directory reads, and access mutations are served by
      // the authenticated Express API. Firebase Admin identity lookup bypasses
      // client rules, so Stage A authentication remains intact.
      allow read, create, update, delete: if false;
    }

    match /sales_teams/{teamId} {
      // Organizational metadata is exposed through the Founder/Admin employee
      // API. Team mutation is outside the Employee Management MVP.
      allow read, create, update, delete: if false;
    }

    // 2. Customers Collection
    match /customers/{customerId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create, update: if isSalesExecutive();
      allow delete: if isAdmin();
    }

    // 3. Leads Collection (Scoped access)
    match /leads/{leadId} {
      allow read: if isSalesManager() || isAccounts() || 
                  (isSalesExecutive() && (resource.data.assignedEmployeeId == request.auth.uid || resource.data.assignedEmployeeId == ''));
      // DIRECT CLIENT MUTATION PROHIBITED FOR ALL ROLES (Server Admin SDK Only)
      allow create, update, delete: if false;
    }

    // 4. Companies Collection
    match /companies/{companyId} {
      allow read: if isSalesExecutive() || isAccounts() || isAdmin();
      allow create, update: if isSalesExecutive();
      allow delete: if isAdmin();
    }

    // 5. Conversations Collection
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 6. Messages Collection (Append-only)
    match /messages/{messageId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 7. Tasks Collection
    match /tasks/{taskId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 8. Quotes Collection
    match /quotes/{quoteId} {
      // Quote access is server-authoritative. The Express API verifies Firebase
      // identity, resolves BBOS employee identity, applies OWN/TEAM/ALL policy,
      // and returns explicit DTOs. Admin SDK traffic bypasses these client rules.
      allow read, create, update, delete: if false;
    }

    // 9. Quote Conversions Collection (Immutable Server-Authoritative Conversion Markers)
    match /quote_conversions/{conversionId} {
      // Read restricted to Founder, Admin, Accounts for audit tracing
      allow read: if isFounder() || isAdmin() || isAccounts();
      // DIRECT CLIENT MUTATION PROHIBITED FOR ALL ROLES (Server Admin SDK Only)
      allow create, update, delete: if false;
    }

    // 10. Bookings Collection (Commercial Root)
    match /bookings/{bookingId} {
      // D3A: Booking reads are server-authoritative. Express resolves the
      // stable employeeId and applies ALL/TEAM/OWN/ASSIGNED policy plus an
      // explicit role-specific DTO. Admin SDK traffic bypasses client rules.
      allow read: if false;
      // D3C: the Booking root is server-authoritative. This prevents browser
      // clients from forging workflow status, ownership, assignments, payment
      // aggregates, confirmation progress, or selling price. Admin SDK writes
      // continue through authenticated, policy-enforced server workflows.
      // Protected includes status, assignedSalesEmployeeId, salesTeamId,
      // assignedReservationsEmployeeId, assignedOperationsEmployeeId,
      // totalSellingPrice, amountReceived, amountPending, paymentStatus,
      // confirmationProgress, isOverpaid, overpaidAmount, and schemaVersion.
      allow create, update, delete: if false;

      // RESTRICTED FINANCIAL SNAPSHOT (SUBCOLLECTION)
      match /financial_snapshot/{snapshotId} {
        // Read strictly restricted to Founder, Admin, Accounts
        allow read: if isFounder() || isAdmin() || isAccounts();
        // DIRECT CLIENT MUTATION PROHIBITED FOR ALL ROLES (Server Admin SDK Only)
        allow create, update, delete: if false;
      }
    }

    // 10. Trips & Itinerary Collections
    match /trips/{tripId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      // Stage D2A: commercial Trip creation and updates are server-authoritative.
      // The Admin SDK writes only after the centralized policy has authorized
      // the stable employee owner/team and server-derived financial fields.
      allow create, update: if false;
      // D2B: deletion uses the same server-side resource scope and workflow
      // checks as commercial mutations; no role-only browser delete bypass.
      allow delete: if false;
    }

    match /itinerary_days/{dayId} {
      allow read: if isSalesExecutive() || isOperations();
      // D2B: the parent Trip is loaded and authorized by Express before every
      // itinerary mutation. Client-side writes cannot bypass that boundary.
      allow create, update, delete: if false;
    }

    // 11. Accommodation Inventory & Rate Management
    match /accommodation_properties/{propertyId} {
      allow read: if isAuthenticated();
      // Only Admin and Operations can manage base accommodation details
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /room_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /property_photos/{photoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isOperations();
    }

    // Rate Management — STRICLTY GATED
    match /rate_periods/{rateId} {
      // Readable by Reservations, Accounts, and Leadership (not Operations)
      allow read: if isReservations() || isAccounts();
      // Reservations overrides remain deferred until Stage C DTO/audit policy.
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /rate_supplements/{supplementId} {
      allow read: if isReservations() || isAccounts();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /negotiated_rates/{rateId} {
      // Readable by Reservations, Accounts, and Leadership
      allow read: if isReservations() || isAccounts();
      allow create, update: if isAccounts();
      allow delete: if isAdmin();
    }

    match /rate_history/{historyId} {
      allow read: if isReservations() || isAccounts();
      allow create: if isAccounts();
      allow update, delete: if false; // Immutable audit log
    }

    // =========================================================================
    // PHASE 2B-4: TRANSPORT & ACTIVITY INVENTORY
    // =========================================================================

    match /vehicle_categories/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /destinations/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /transport_routes/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /transport_rate_periods/{docId} {
      allow read: if isReservations() || isAccounts();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /transport_supplements/{docId} {
      allow read: if isReservations() || isAccounts();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /negotiated_transport_rates/{docId} {
      allow read: if isReservations() || isAccounts();
      allow create, update: if isAccounts();
      allow delete: if isAdmin();
    }

    match /activity_masters/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isOperations();
      allow delete: if isAdmin();
    }

    match /activity_rate_periods/{docId} {
      allow read: if isReservations() || isAccounts();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /negotiated_activity_rates/{docId} {
      allow read: if isReservations() || isAccounts();
      allow create, update: if isAccounts();
      allow delete: if isAdmin();
    }

    match /transport_rate_history/{docId} {
      allow read: if isReservations() || isAccounts();
      allow create: if isAccounts();
      allow update, delete: if false;
    }

    match /activity_rate_history/{docId} {
      allow read: if isReservations() || isAccounts();
      allow create: if isAccounts();
      allow update, delete: if false;
    }

    // =========================================================================
    // PHASE 2B-5: MODERN SERVICE COLLECTIONS
    // =========================================================================

    match /booking_accommodations/{docId} {
      // D3A Booking detail reads are resource-scoped and projected by Express.
      allow read: if false;
      allow create: if isAdmin(); // Created via Server Conversion Engine
      
      // D3B supplier-confirmation fields are server-only for every browser role.
      // Sales may modify ONLY guestNames/specialRequests; Operations may modify
      // unrelated legacy operational fields until their later migration.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'sourceQuoteServiceId', 'confirmationStatus', 'supplierConfirmationCode',
          'allocatedRoomNumbers', 'supplierNotes', 'supplierConfirmation'
        ]) && (
          isAdmin() ||
          (isOperations() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'bookingId', 'tripId', 'customerId', 'propertyId', 'propertyName', 'roomCategoryId',
            'roomCategoryName', 'mealPlan', 'checkInDate', 'checkOutDate', 'nightsCount',
            'roomsCount', 'adultsCount', 'childrenCount', 'schemaVersion'
          ])) ||
          (isSalesExecutive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guestNames', 'specialRequests'
          ]))
        );
      allow delete: if isAdmin();
    }

    match /booking_transports/{docId} {
      allow read: if false;
      allow create: if isAdmin(); // Created via Server Conversion Engine
      
      // D3C confirmation/dispatch fields are server-only for every browser
      // role; unrelated legacy edits remain unchanged until their own slice.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'confirmationStatus', 'driverId', 'driverName', 'driverPhone',
          'vehicleRegistrationNumber', 'operationalNotes', 'supplierNotes'
        ]) && (
          isAdmin() ||
          (isOperations() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'bookingId', 'tripId', 'customerId', 'vehicleCategoryId', 'vehicleCategoryName',
            'routeId', 'routeName', 'serviceDate', 'endDate', 'daysCount', 'pickupLocation',
            'dropoffLocation', 'pickupTime', 'schemaVersion'
          ])) ||
          (isSalesExecutive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'passengerCount', 'specialRequests'
          ]))
        );
      allow delete: if isAdmin();
    }

    match /booking_activities/{docId} {
      allow read: if false;
      allow create: if isAdmin(); // Created via Server Conversion Engine
      
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'confirmationStatus', 'supplierConfirmationCode', 'ticketNumbers',
          'assignedGuideName', 'assignedGuidePhone', 'operationalNotes'
        ]) && (
          isAdmin() ||
          (isOperations() && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'bookingId', 'tripId', 'customerId', 'activityMasterId', 'activityName',
            'destinationId', 'destinationName', 'serviceDate', 'sessionTime', 'schemaVersion'
          ])) ||
          (isSalesExecutive() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'participantCount', 'leadGuestName', 'specialRequests'
          ]))
        );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PHASE 2B-5: PAYMENTS COLLECTION
    // =========================================================================

    match /payments/{paymentId} {
      // D4A: all payment access is mediated by authenticated Express APIs using
      // canonical BBOS employeeId and centralized resource authorization.
      allow read, create, update, delete: if false;
    }

    match /supplier_payments/{paymentId} {
      // D4B: supplier disbursement history, verification state, and linkage to
      // immutable Booking snapshots are available only through server APIs.
      allow read, create, update, delete: if false;
    }

    // =========================================================================
    // 12. LEGACY COLLECTIONS (STRICT READ-ONLY HISTORICAL FREEZE)
    // =========================================================================
    match /hotels/{hotelId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /hotel_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /hotel_bookings/{bookingId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create, update, delete: if false; // Frozen: Read-only historical collection
    }

    match /transports/{transportId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create, update, delete: if false; // Frozen: Read-only historical collection
    }

    match /drivers/{driverId} {
      allow read: if isSalesExecutive() || isOperations();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /activity_bookings/{bookingId} {
      allow read: if isSalesExecutive() || isOperations() || isAccounts();
      allow create, update, delete: if false; // Frozen: Read-only historical collection
    }

    // 12. Suppliers & Vouchers
    match /suppliers/{supplierId} {
      allow read: if isOperations() || isAccounts();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    match /vouchers/{voucherId} {
      allow read: if isSalesExecutive() || isOperations();
      allow create, update: if isOperations();
      allow delete: if isAdmin();
    }

    // 13. Packages
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 14. Audit Logs (Append-only, strictly immutable)
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isAccounts();
      // D1 Quote events are emitted only by server transactions. Keep legacy
      // client audit behavior for unmigrated domains until their Stage D slice.
      allow create: if isAuthenticated() &&
                    request.resource.data.actorId != null &&
                    request.resource.data.entityType != 'PAYMENT' &&
                    request.resource.data.entityType != 'SUPPLIER_PAYMENT' &&
                    request.resource.data.entityType != 'EMPLOYEE' &&
                    !(request.resource.data.action in [
                      'QUOTE_CREATED',
                      'QUOTE_UPDATED',
                      'QUOTE_CONVERTED_TO_BOOKING',
                      'PAYMENT_RECORDED',
                      'PAYMENT_VERIFIED',
                      'PAYMENT_REJECTED',
                      'PAYMENT_VOIDED',
                      'BOOKING_CONFIRMED_FROM_PAYMENT',
                      'SUPPLIER_PAYMENT_RECORDED',
                      'SUPPLIER_PAYMENT_VERIFIED',
                      'SUPPLIER_PAYMENT_REJECTED',
                      'SUPPLIER_PAYMENT_VOIDED',
                      'SUPPLIER_SETTLED',
                      'EMPLOYEE_CREATED',
                      'EMPLOYEE_ROLE_CHANGED',
                      'EMPLOYEE_TEAM_CHANGED',
                      'EMPLOYEE_MANAGER_CHANGED',
                      'EMPLOYEE_ACTIVATED',
                      'EMPLOYEE_DEACTIVATED',
                      'EMPLOYEE_PROFILE_UPDATED',
                      'OPERATIONS_ASSIGNED',
                      'OPERATIONS_REASSIGNED'
                    ]);
      allow update, delete: if false;
    }

    // 15. AI Recommendations, Actions, and Approvals
    match /ai_recommendations/{recId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    match /ai_actions/{actionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isSalesManager() || isAccounts();
      allow delete: if false;
    }

    match /approvals/{approvalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSalesManager() || isAccounts();
      allow delete: if false;
    }

    // Default: Deny all unauthenticated or unlisted collection access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
