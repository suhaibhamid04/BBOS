rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Employees Collection
    match /employees/{employeeId} {
      // Employee identity, directory reads, and access mutations are served by
      // the authenticated Express API. Firebase Admin identity lookup bypasses
      // client rules, so Stage A authentication remains intact.
      allow read, create, update, delete: if false;
    }

    match /sales_teams/{teamId} {
      // Organizational metadata is exposed through the Founder/Admin employee
      // API. Team mutation is outside the Employee Management MVP.
      allow read, create, update, delete: if false;
    }

    // 2. Customers Collection
    match /customers/{customerId} {
      // Customer PII is projected by the scoped customer API using canonical
      // employeeId/salesTeamId and Lead-linked ownership evidence.
      allow read, create, update, delete: if false;
    }

    // 3. Leads Collection
    match /leads/{leadId} {
      // Lead scope uses stable BBOS employeeId/salesTeamId and is enforced by
      // the authenticated Express API. Firebase UID is intentionally not used
      // as the business owner identifier.
      allow read, create, update, delete: if false;
    }

    match /lead_distribution_configs/{configId} {
      // Distribution policy is readable and mutable only through the
      // authenticated Founder/Admin API.
      allow read, create, update, delete: if false;
    }

    match /lead_distribution_state/{stateId} {
      // Round-robin position is server-authoritative transactional state.
      allow read, create, update, delete: if false;
    }

    match /lead_assignment_history/{eventId} {
      // Immutable history is projected through scoped Lead APIs.
      allow read, create, update, delete: if false;
    }

    match /lead_events/{eventId} {
      // Sales interactions and follow-up history are written transactionally
      // by the authenticated Express API only.
      allow read, create, update, delete: if false;
    }

    match /conversation_entries/{entryId} {
      // M6A/M6B communications, provider status and internal notes are scoped
      // through authenticated APIs. Public Meta webhook writes are verified
      // and performed by Admin SDK; browser clients cannot forge delivery state.
      allow read, create, update, delete: if false;
    }

    match /unmatched_whatsapp/{messageId} {
      // Unresolved provider messages contain customer communications and are
      // exposed only through the Founder/Admin server workflow.
      allow read, create, update, delete: if false;
    }

    match /whatsapp_webhook_events/{eventId} {
      // Server-only idempotency receipts for signed Meta webhook deliveries.
      allow read, create, update, delete: if false;
    }

    match /whatsapp_pending_statuses/{statusId} {
      // Short-lived server reconciliation records for a provider status that
      // races ahead of outbound message finalization.
      allow read, create, update, delete: if false;
    }

    // 4. Companies Collection
    match /companies/{companyId} {
      allow read, create, update, delete: if false;
    }

    // 5. Conversations Collection
    match /conversations/{conversationId} {
      // Retired in favor of Lead-scoped conversation_entries (M6A/M6B).
      allow read, create, update, delete: if false;
    }

    // 6. Messages Collection (Append-only)
    match /messages/{messageId} {
      allow read, create, update, delete: if false;
    }

    // 7. Tasks Collection
    match /tasks/{taskId} {
      // M3 Lead nextFollowUpAt/events/queue are authoritative.
      allow read, create, update, delete: if false;
    }

    // 8. Quotes Collection
    match /quotes/{quoteId} {
      // Quote access is server-authoritative. The Express API verifies Firebase
      // identity, resolves BBOS employee identity, applies OWN/TEAM/ALL policy,
      // and returns explicit DTOs. Admin SDK traffic bypasses these client rules.
      allow read, create, update, delete: if false;
    }

    match /customer_shares/{shareId} {
      // Secure tokens, immutable customer snapshots, expiry, revocation, and
      // view counters are exclusively managed by the Express/Admin SDK layer.
      allow read, create, update, delete: if false;
    }

    // 9. Quote Conversions Collection (Immutable Server-Authoritative Conversion Markers)
    match /quote_conversions/{conversionId} {
      allow read, create, update, delete: if false;
    }

    // 10. Bookings Collection (Commercial Root)
    match /bookings/{bookingId} {
      // D3A: Booking reads are server-authoritative. Express resolves the
      // stable employeeId and applies ALL/TEAM/OWN/ASSIGNED policy plus an
      // explicit role-specific DTO. Admin SDK traffic bypasses client rules.
      allow read: if false;
      // D3C: the Booking root is server-authoritative. This prevents browser
      // clients from forging workflow status, ownership, assignments, payment
      // aggregates, confirmation progress, or selling price. Admin SDK writes
      // continue through authenticated, policy-enforced server workflows.
      // Protected includes status, assignedSalesEmployeeId, salesTeamId,
      // assignedReservationsEmployeeId, assignedOperationsEmployeeId,
      // totalSellingPrice, amountReceived, amountPending, paymentStatus,
      // confirmationProgress, isOverpaid, overpaidAmount, and schemaVersion.
      allow create, update, delete: if false;

      // RESTRICTED FINANCIAL SNAPSHOT (SUBCOLLECTION)
      match /financial_snapshot/{snapshotId} {
        allow read, create, update, delete: if false;
      }
    }

    // 10. Trips & Itinerary Collections
    match /trips/{tripId} {
      // Reads use the scoped API and its role-specific financial projection.
      allow read: if false;
      // Stage D2A: commercial Trip creation and updates are server-authoritative.
      // The Admin SDK writes only after the centralized policy has authorized
      // the stable employee owner/team and server-derived financial fields.
      allow create, update: if false;
      // D2B: deletion uses the same server-side resource scope and workflow
      // checks as commercial mutations; no role-only browser delete bypass.
      allow delete: if false;
    }

    match /itinerary_days/{dayId} {
      allow read: if false;
      // D2B: the parent Trip is loaded and authorized by Express before every
      // itinerary mutation. Client-side writes cannot bypass that boundary.
      allow create, update, delete: if false;
    }

    // 11. Accommodation Inventory & Rate Management
    match /accommodation_properties/{propertyId} {
      allow read, create, update, delete: if false;
    }

    match /room_categories/{categoryId} {
      allow read, create, update, delete: if false;
    }

    match /property_photos/{photoId} {
      allow read, create, update, delete: if false;
    }

    // Rate Management — STRICLTY GATED
    match /rate_periods/{rateId} {
      allow read, create, update, delete: if false;
    }

    match /rate_supplements/{supplementId} {
      allow read, create, update, delete: if false;
    }

    match /negotiated_rates/{rateId} {
      allow read, create, update, delete: if false;
    }

    match /rate_history/{historyId} {
      allow read, create, update, delete: if false;
    }

    // =========================================================================
    // PHASE 2B-4: TRANSPORT & ACTIVITY INVENTORY
    // =========================================================================

    match /vehicle_categories/{docId} {
      allow read, create, update, delete: if false;
    }

    match /destinations/{docId} {
      allow read, create, update, delete: if false;
    }

    match /transport_routes/{docId} {
      allow read, create, update, delete: if false;
    }

    match /transport_rate_periods/{docId} {
      allow read, create, update, delete: if false;
    }

    match /transport_supplements/{docId} {
      allow read, create, update, delete: if false;
    }

    match /negotiated_transport_rates/{docId} {
      allow read, create, update, delete: if false;
    }

    match /activity_masters/{docId} {
      allow read, create, update, delete: if false;
    }

    match /activity_rate_periods/{docId} {
      allow read, create, update, delete: if false;
    }

    match /negotiated_activity_rates/{docId} {
      allow read, create, update, delete: if false;
    }

    match /transport_rate_history/{docId} {
      allow read, create, update, delete: if false;
    }

    match /activity_rate_history/{docId} {
      allow read, create, update, delete: if false;
    }

    // =========================================================================
    // PHASE 2B-5: MODERN SERVICE COLLECTIONS
    // =========================================================================

    match /booking_accommodations/{docId} {
      // Scope, state transitions, supplierConfirmation, guestNames and
      // specialRequests are validated by server workflows for every role.
      allow read, create, update, delete: if false;
    }

    match /booking_transports/{docId} {
      // confirmationStatus, driverName, driverPhone and other fields are
      // server-authoritative; no cross-booking passengerCount write bypass.
      allow read, create, update, delete: if false;
    }

    match /booking_activities/{docId} {
      // confirmationStatus, supplierConfirmationCode, ticketNumbers and
      // participantCount changes require the server's resource policy.
      allow read, create, update, delete: if false;
    }

    // =========================================================================
    // PHASE 2B-5: PAYMENTS COLLECTION
    // =========================================================================

    match /payments/{paymentId} {
      // D4A: all payment access is mediated by authenticated Express APIs using
      // canonical BBOS employeeId and centralized resource authorization.
      allow read, create, update, delete: if false;
    }

    // D5B live Operations records are projected and mutated only by Express.
    match /booking_operational_issues/{issueId} {
      allow read, create, update, delete: if false;
    }

    match /operational_change_requests/{requestId} {
      allow read, create, update, delete: if false;
    }

    match /emergency_spend_requests/{requestId} {
      allow read, create, update, delete: if false;
    }

    match /supplier_payments/{paymentId} {
      // D4B: supplier disbursement history, verification state, and linkage to
      // immutable Booking snapshots are available only through server APIs.
      allow read, create, update, delete: if false;
    }

    // A01 financial and commercial exception workflows are server-authoritative.
    // Browser clients use authenticated Express APIs so actor identity, scope,
    // separation of duties, state transitions, and ledger immutability can be
    // enforced transactionally.
    match /booking_amendments/{amendmentId} {
      allow read, create, update, delete: if false;
    }

    match /supplier_substitutions/{substitutionId} {
      allow read, create, update, delete: if false;
    }

    match /refund_requests/{refundId} {
      allow read, create, update, delete: if false;
    }

    match /refund_ledger/{entryId} {
      allow read, create, update, delete: if false;
    }

    match /commission_ledger/{entryId} {
      allow read, create, update, delete: if false;
    }

    match /financial_policies/{policyId} {
      allow read, create, update, delete: if false;
    }

    // =========================================================================
    // 12. LEGACY COLLECTIONS (STRICT READ-ONLY HISTORICAL FREEZE)
    // =========================================================================
    match /hotels/{hotelId} {
      allow read, create, update, delete: if false;
    }

    match /hotel_rooms/{roomId} {
      allow read, create, update, delete: if false;
    }

    match /hotel_bookings/{bookingId} {
      allow read, create, update, delete: if false;
    }

    match /transports/{transportId} {
      allow read, create, update, delete: if false;
    }

    match /drivers/{driverId} {
      allow read, create, update, delete: if false;
    }

    match /activities/{activityId} {
      allow read, create, update, delete: if false;
    }

    match /activity_bookings/{bookingId} {
      allow read, create, update, delete: if false;
    }

    // 12. Suppliers & Vouchers
    match /suppliers/{supplierId} {
      // UX1 supplier identity and inventory linkage are server-authoritative.
      allow read, create, update, delete: if false;
    }

    match /vouchers/{voucherId} {
      allow read, create, update, delete: if false;
    }

    // 13. Packages
    match /packages/{packageId} {
      allow read, create, update, delete: if false;
    }

    // 14. Audit Logs (Append-only, strictly immutable)
    match /audit_logs/{logId} {
      // Audit events are immutable server-side records. Read projection is not
      // exposed until a dedicated metadata-safe API exists.
      allow read, create, update, delete: if false;
    }

    // 15. AI Recommendations, Actions, and Approvals
    match /ai_recommendations/{recId} {
      allow read, create, update, delete: if false;
    }

    match /ai_actions/{actionId} {
      allow read, create, update, delete: if false;
    }

    match /approvals/{approvalId} {
      // Unified approval listing/decisions are mediated by authenticated APIs.
      // This legacy collection is not an authoritative approval workflow.
      allow read, create, update, delete: if false;
    }

    // Default: Deny all unauthenticated or unlisted collection access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
