# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Demo mode is opt-in and is rejected by the API when NODE_ENV=production.
# Set both values to true only for local demo development.
BBOS_DEMO_MODE="false"
VITE_BBOS_DEMO_MODE="false"

# Runtime profile. Use development for the development Firebase project,
# test only with emulators, and production only in the deployed production service.
BBOS_ENVIRONMENT="development"
VITE_BBOS_ENVIRONMENT="development"

# Canonical Firebase topology. Production startup requires both values and
# never falls back to another project or database. Use the literal `(default)`
# for Firestore's default database; otherwise use the approved named database.
# Vite injects these non-secret identifiers into the browser build from the
# same variables consumed by the server.
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
BBOS_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_BBOS_FIRESTORE_DATABASE_ID="(default)"

# Public Firebase Web App configuration. These values identify a browser app;
# they are not Firebase Admin credentials. Keep Admin credentials server-only.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Approved emergency diagnostics only. Both flags are required and all API
# mutation methods are denied by the server while enabled.
BBOS_LOCAL_PRODUCTION_DIAGNOSTIC="false"
BBOS_READ_ONLY_DIAGNOSTIC="false"
VITE_BBOS_LOCAL_PRODUCTION_DIAGNOSTIC="false"
VITE_BBOS_READ_ONLY_DIAGNOSTIC="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Meta WhatsApp Cloud API (server-only; never prefix these with VITE_)
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
META_WHATSAPP_APP_SECRET=""
META_WHATSAPP_GRAPH_API_VERSION="vXX.X"
# JSON allowlist of templates already approved in WhatsApp Manager.
META_WHATSAPP_APPROVED_TEMPLATES='[{"name":"kashmir_package_ready","label":"Kashmir package ready","languageCode":"en_US"}]'
