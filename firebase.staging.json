{
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "booking-bridge-bbos-stage",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server.js",
      "server.js.map"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "bbos-staging-backend",
          "region": "asia-south2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
