{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "NODE_ENV=production bun dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist/server.js",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "firebase emulators:exec --config firebase.qa3.json --project bbos-qa3-local --only auth,firestore \"playwright test --config playwright.firebase.config.ts\"",
    "test:auth-emulator": "firebase emulators:exec --config firebase.qa3.json --project bbos-qa3-local --only auth \"bun test tests/server/firebase-auth-emulator.integration.test.ts\"",
    "migrate:leads:team": "bun scripts/backfillLeadSalesTeam.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.32.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
